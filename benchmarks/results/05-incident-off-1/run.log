+      { id: 'order-2', user_id: 'user-1' },
+    ];
+    const db = { query: () => expectedOrders };
+
+    const orders = getUserOrders(db, 'user-1');
+
+    assert.strictEqual(orders, expectedOrders);
+  });
+});

