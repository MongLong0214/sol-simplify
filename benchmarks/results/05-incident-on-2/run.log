+test('getUserOrders returns an empty array when the user has no orders', () => {
+  const db = {
+    query(sql, params) {
+      assert.equal(sql, 'SELECT * FROM orders WHERE user_id = ?');
+      assert.deepEqual(params, ['user-without-orders']);
+      return [];
+    },
+  };
