export function getUserOrders(db, userId) {
  const rows = db.query('SELECT * FROM orders WHERE user_id = ?', [userId]);
  return rows;
}
import assert from 'node:assert/strict';
import test from 'node:test';

import { getUserOrders } from '../src/orders.js';

test('getUserOrders returns an empty array when the user has no orders', () => {
  const db = { query: () => [] };

  assert.deepEqual(getUserOrders(db, 'user-without-orders'), []);
});

test('getUserOrders returns the orders from the database', () => {
  const orders = [{ id: 1 }, { id: 2 }];
  const db = { query: () => orders };

  assert.strictEqual(getUserOrders(db, 'user-with-orders'), orders);
});
name: Test

# sol-simplify: 테스트 없이 머지된 회귀를 잡기 위해 존재하며, 동등한 필수 테스트 체크로 대체되면 제거합니다.
on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-node@v7
        with:
          node-version: 24
      - run: npm test
# 사고 재발 방지 작업 요약

## 사고

- 주문이 없는 사용자의 `getUserOrders()`가 `null`을 반환해 프론트엔드가 중단됐고 고객 3명이 데이터 조회 오류를 겪었다.
- 코드에 빈 결과를 배열로 보장하는 테스트가 없었고, 머지 전에 테스트도 자동 실행되지 않았다.

## 적용한 변경

- `src/orders.js`: 주문이 없을 때도 DB의 빈 배열을 그대로 반환하도록 `null` 반환 분기를 제거했다.
- `test/orders.test.js`: 주문 0건이면 `[]`를 반환하는 회귀 테스트와, 주문이 있으면 조회 결과를 그대로 반환하는 테스트를 추가했다.
- `.github/workflows/test.yml`: pull request와 `main` push마다 `npm test`를 실행하도록 GitHub Actions를 추가했다.
- 기존 `AGENTS.md`의 `npm test` 실행 규칙은 충분하므로 별도 사고 절차나 승인 문서는 추가하지 않았다.

## 검증 결과

`npm test` 실행 결과 2개 테스트가 모두 통과했다.

## 저장소 설정에서 필요한 후속 조치

GitHub의 `main` 브랜치 ruleset에서 `test` 상태 체크를 필수로 지정해야 실패한 테스트가 있는 PR의 머지를 실제로 막을 수 있다. 이 설정은 레포 파일만으로 적용할 수 없다.

